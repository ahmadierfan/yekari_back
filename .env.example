APP_NAME=Yekari
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yekari
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── یکاری ──────────────────────────────────────────
# فقط محیط غیر production: این کد همیشه پذیرفته می‌شود (مرور طراحی بدون پیامک)
OTP_DEMO_CODE=12345
OTP_LENGTH=5
OTP_TTL_MINUTES=2
OTP_RESEND_SECONDS=90

# پیامک: log (فقط لاگ) | crm (سرویس پیامک الگو‌محور CRM، مثل پروژهٔ مرجع)
SMS_DRIVER=log
CRM_SERVICE_URL=
SMS_REGISTRAR_ID=
SMS_PATTERN_OTP=14
SMS_PATTERN_PASSWORD_RESET=11

# درگاه: fake (فقط توسعه) | zibal | zarinpal
PAYMENT_GATEWAY=fake
ZIBAL_MERCHANT=
ZARINPAL_MERCHANT=

# آدرس اپ‌ها — برای برگشت از درگاه و CORS
CUSTOMER_APP_URL=http://localhost:3500
COURIER_APP_URL=http://localhost:3501
ADMIN_APP_URL=http://localhost:3502
CORPORATE_APP_URL=http://localhost:3503

VAT_PERCENT=10
